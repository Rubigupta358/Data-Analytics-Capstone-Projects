table DimProduct

	column ProductKey
		dataType: int64
		summarizeBy: none
		sourceColumn: ProductKey

	column ProductName
		dataType: string
		summarizeBy: none
		sourceColumn: ProductName

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	column Subcategory
		dataType: string
		summarizeBy: none
		sourceColumn: Subcategory

	column UnitCost
		dataType: double
		summarizeBy: sum
		formatString: #,0.00
		sourceColumn: UnitCost

	column UnitPrice
		dataType: double
		summarizeBy: sum
		formatString: #,0.00
		sourceColumn: UnitPrice

	partition DimProduct = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\DimProduct.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"ProductKey", Int64.Type}, {"ProductName", type text}, {"Category", type text}, {"Subcategory", type text}, {"UnitCost", type number}, {"UnitPrice", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
