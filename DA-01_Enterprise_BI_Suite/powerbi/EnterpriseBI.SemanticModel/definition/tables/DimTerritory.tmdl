table DimTerritory

	column TerritoryKey
		dataType: int64
		summarizeBy: none
		sourceColumn: TerritoryKey

	column Region
		dataType: string
		summarizeBy: none
		sourceColumn: Region

	column Country
		dataType: string
		summarizeBy: none
		sourceColumn: Country

	column GroupName
		dataType: string
		summarizeBy: none
		sourceColumn: GroupName

	partition DimTerritory = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\DimTerritory.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"TerritoryKey", Int64.Type}, {"Region", type text}, {"Country", type text}, {"GroupName", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
