table DimCustomer

	column CustomerKey
		dataType: int64
		summarizeBy: none
		sourceColumn: CustomerKey

	column CustomerName
		dataType: string
		summarizeBy: none
		sourceColumn: CustomerName

	column Region
		dataType: string
		summarizeBy: none
		sourceColumn: Region

	column Country
		dataType: string
		summarizeBy: none
		sourceColumn: Country

	column CustomerSegment
		dataType: string
		summarizeBy: none
		sourceColumn: CustomerSegment

	partition DimCustomer = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\DimCustomer.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"CustomerKey", Int64.Type}, {"CustomerName", type text}, {"Region", type text}, {"Country", type text}, {"CustomerSegment", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
